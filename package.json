{
  "name": "video-editor",
  "version": "1.2.0",
  "private": true,
  "description": "AI-drivable deterministic video editor. The AI composes a timeline (EDL); FFmpeg renders the pixels.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "mcp": "npm run start --workspace @video-editor/mcp-server",
    "desktop": "npm run dev --workspace @video-editor/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.1": true,
    "electron@33.4.11": true,
    "node-pty@1.1.0": true,
    "@homebridge/node-pty-prebuilt-multiarch@0.14.1": true,
    "electron-winstaller@5.4.0": true
  }
}
